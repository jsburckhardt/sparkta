{
  "name": "@sparkta/server",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Sparkta Fastify server foundation",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "fastify": "^5.11.2",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
